  "geometryPolicy": "All accepted POSITION/NORMAL/UV/index/tangent accessors retained; see geometry-preservation.json",
  "finishRevision": 1,
  "scriptSha256": "f0e09c97c1f96e37a2c3511579e490ef3da3c9f05c9051289ae96e7b4c4f7544",
  "reproduction": {
    "script": "artifacts/l10-acceptance-85/validate-packed-finish.py",
    "command": "artifacts/l10-phase4/tools/blender-4.5.9-windows-x64/blender.exe --background --python artifacts/l10-acceptance-85/validate-packed-finish.py",
    "pythonSource": "\"\"\"Read-only portability and source/material verification; never saves a blend.\"\"\"\nfrom pathlib import Path\nimport hashlib,json,struct\nimport bpy\nimport numpy as np\n\nroot=Path.cwd();source=root/'assets/l10-prototype/bare-compute-boards.blend'\nsource_hash=hashlib.sha256(source.read_bytes()).hexdigest()\nbpy.ops.wm.open_mainfile(filepath=str(source))\nreport={'source':source.relative_to(root).as_posix(),'sourceSha256':source_hash,'readOnly':True,'images':[],'materials':[],'opticalThicknessMaps':[]}\npixels_by_name={}\nfor im in bpy.data.images:\n    if im.source not in {'FILE','GENERATED'} or not im.size[0] or not im.size[1]:\n        continue\n    assert im.packed_file, 'Missing packed image: '+im.name\n    file=Path(bpy.path.abspath(im.filepath))\n    assert file.is_file(), 'Missing external source map: '+str(file)\n    packed=bytes(im.packed_file.data);external=file.read_bytes()\n    # Packed raster content is the portability source of truth. Also verify\n    # that editable external maps contain exactly the same decoded pixels.\n    original=np.empty(len(im.pixels),np.float32);im.pixels.foreach_get(original)\n    check=bpy.data.images.load(str(file),check_existing=False)\n    check.colorspace_settings.name=im.colorspace_settings.name\n    decoded=np.empty(len(check.pixels),np.float32);check.pixels.foreach_get(decoded)\n    assert original.shape==decoded.shape and np.array_equal(original,decoded), im.name+' pixel mismatch'\n    bpy.data.images.remove(check)\n    pixels_by_name[im.name]=original.reshape((im.size[1],im.size[0],4)).copy()\n    report['images'].append({'name':im.name,'size':list(im.size),'colorSpace':im.colorspace_settings.name,\n        'packedBytes':len(packed),'packedSha256':hashlib.sha256(packed).hexdigest(),\n        'externalSha256':hashlib.sha256(external).hexdigest(),'pixelsSha256':hashlib.sha256(original.tobytes()).hexdigest(),\n        'externalPixelsIdentical':True,'path':file.relative_to(root).as_posix()})\n\nglb=root/'app/static/models/l10-prototype/bare-compute-boards.glb';raw=glb.read_bytes()\nn=struct.unpack_from('<I',raw,12)[0];doc=json.loads(raw[20:20+n]);binary=raw[28+n:]\nmaterial_by_name={m.name:m for m in bpy.data.materials}\nfor material in doc['materials']:\n    board=material.get('extras',{}).get('l10ContactBoard')\n    name=material['name']+(' / '+board+' contact AO' if board else '')\n    source_material=material_by_name[name]\n    p=source_material.node_tree.nodes.get('Principled BSDF')\n    if not p:\n        continue\n    pbr=material.get('pbrMetallicRoughness',{})\n    for attribute,socket,default in [('metallicFactor','Metallic',1),('roughnessFactor','Roughness',1)]:\n        if not p.inputs[socket].is_linked:\n            assert abs(p.inputs[socket].default_value-pbr.get(attribute,default))<1e-6,(name,attribute)\n    if not p.inputs['Base Color'].is_linked:\n        assert np.allclose(p.inputs['Base Color'].default_value,pbr.get('baseColorFactor',[1]*4),atol=1e-6),name\n    for field in ('l10ThinFilmStrength','l10ThinFilmThickness'):\n        if field in source_material:\n            assert source_material[field]==material['extras'][field],(name,field)\n    if 'normalTexture' in material:\n        normals=[node for node in source_material.node_tree.nodes if node.type=='NORMAL_MAP']\n        assert len(normals)==1 and abs(normals[0].inputs['Strength'].default_value-material['normalTexture'].get('scale',1))<1e-6,name\n    # Emission is forbidden both in exported glTF and in the editable source.\n    assert not material.get('emissiveTexture'),name+' emissive texture'\n    assert np.array_equal(material.get('emissiveFactor',[0,0,0]),[0,0,0]),name+' emissive factor'\n    assert not any(node.type=='EMISSION' for node in source_material.node_tree.nodes),name+' emission node'\n    emission=p.inputs.get('Emission Color') or p.inputs.get('Emission')\n    strength=p.inputs.get('Emission Strength')\n    assert not emission or not emission.is_linked,name+' linked emission color'\n    assert not strength or not strength.is_linked,name+' linked emission strength'\n    emission_zero=(not strength or strength.default_value==0) or (emission and np.array_equal(list(emission.default_value)[:3],[0,0,0]))\n    assert emission_zero,name+' source emits light'\n    extras=material.get('extras',{})\n    if extras.get('l10ThinFilmStrength',0)>0:\n        texture=pbr['metallicRoughnessTexture']['index']\n        image_name=doc['images'][doc['textures'][texture]['source']]['name']\n        authored=next(key for key in pixels_by_name if key in (image_name,image_name+'.png'))\n        pixels=pixels_by_name[authored]\n        red=pixels[:,:,0]\n        lo,hi=float(red.min()),float(red.max())\n        assert 0<=lo<hi<=1 and hi-lo>.04, name+' requires authored variable MR.r thickness'\n        assert float(red.std())>.003,name+' optical map is effectively flat'\n        assert len(np.unique(np.rint(red*255).astype(np.uint8)))>8,name+' insufficient optical variation'\n        assert 0<extras['l10ThinFilmStrength']<=.25,name+' unbounded film strength'\n        assert 250<=extras['l10ThinFilmThickness']<=650,name+' unsupported film thickness'\n        assert source_material['l10ThinFilmThicknessMap']==extras['l10ThinFilmThicknessMap'],name+' thickness convention mismatch'\n        report['opticalThicknessMaps'].append({'material':name,'image':image_name,'channel':'metallicRoughness.r',\n            'redMin':lo,'redMax':hi,'redMean':float(red.mean()),'redStd':float(red.std()),\n            'redDistinctByteValues':int(len(np.unique(np.rint(red*255).astype(np.uint8)))),\n            'thicknessRatioRange':[.88+.24*lo,.88+.24*hi],\n            'authoredThicknessNm':extras['l10ThinFilmThickness'],'filmStrength':extras['l10ThinFilmStrength'],\n            'thicknessConvention':extras['l10ThinFilmThicknessMap'],'separateOcclusionTexture':True})\n    report['materials'].append({'name':name,'gltfScalarValuesMatchPackedSource':True,\n        'thinFilmStrength':material.get('extras',{}).get('l10ThinFilmStrength',0),'sourceAndExportEmissionZero':True})\n\nembedded=[]\nfor im in doc['images']:\n    view=doc['bufferViews'][im['bufferView']];offset=view.get('byteOffset',0)\n    data=binary[offset:offset+view['byteLength']]\n    digest=hashlib.sha256(data).hexdigest()\n    authored=next(p for p in report['images'] if p['name'] in (im['name'],im['name']+'.png'))\n    assert digest==authored['externalSha256'], im['name']+' embedded/source image mismatch'\n    optical=next((entry for entry in report['opticalThicknessMaps'] if entry['image']==im['name']),None)\n    if optical:\n        # Independently decode the actual GLB-embedded PNG. Exporters may treat\n        # metallicRoughness.r as unused; authored metadata alone cannot prove it\n        # survived export. Both raw image bytes and decoded red must agree.\n        probe=root/'artifacts/l10-acceptance-85/evidence'/(im['name']+'-embedded-probe.png')\n        probe.write_bytes(data)\n        decoded_image=bpy.data.images.load(str(probe),check_existing=False)\n        decoded_image.colorspace_settings.name='Non-Color'\n        decoded_pixels=np.empty(len(decoded_image.pixels),np.float32)\n        decoded_image.pixels.foreach_get(decoded_pixels)\n        decoded_pixels=decoded_pixels.reshape((decoded_image.size[1],decoded_image.size[0],4))\n        authored_pixels=pixels_by_name[authored['name']]\n        assert np.array_equal(decoded_pixels,authored_pixels),im['name']+' exported pixel mismatch'\n        red=decoded_pixels[:,:,0]\n        assert np.array_equal(red,authored_pixels[:,:,0]),im['name']+' MR red silently repacked'\n        optical.update(embeddedRedMin=float(red.min()),embeddedRedMax=float(red.max()),\n                       embeddedRedStd=float(red.std()),embeddedRedPixelsMatchSource=True,\n                       embeddedPixelsSha256=hashlib.sha256(decoded_pixels.tobytes()).hexdigest())\n        bpy.data.images.remove(decoded_image)\n        probe.unlink()\n    embedded.append({'name':im.get('name'),'sha256':digest,'bytes':len(data),'authoredBytesIdentical':True})\nassert len(report['opticalThicknessMaps'])==3,'CPU, GPU and network optical maps are required'\nassert hashlib.sha256(source.read_bytes()).hexdigest()==source_hash,'Source changed during read-only audit'\nassert hashlib.sha256(glb.read_bytes()).hexdigest()==hashlib.sha256(raw).hexdigest(),'GLB changed during audit'\nscript=Path(__file__).resolve()\nreport.update(status='PASS',packedImageCount=len(report['images']),missingImages=0,\n              glbSha256=hashlib.sha256(raw).hexdigest(),embeddedImageCount=len(embedded),embeddedImages=embedded,\n              geometryPolicy='All accepted POSITION/NORMAL/UV/index/tangent accessors retained; see geometry-preservation.json',\n              finishRevision=doc['extras']['targetedFinishRevision'],\n              scriptSha256=hashlib.sha256(script.read_bytes()).hexdigest(),\n              reproduction={'script':script.relative_to(root).as_posix(),\n                            'command':'artifacts/l10-phase4/tools/blender-4.5.9-windows-x64/blender.exe --background --python artifacts/l10-acceptance-85/validate-packed-finish.py',\n                            'pythonSource':script.read_text()})\nout=root/'artifacts/l10-acceptance-85/evidence/packed-source-portability.json'\nout.write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps({k:report[k] for k in ['status','packedImageCount','missingImages','glbSha256','embeddedImageCount','finishRevision']}))\n"
  }
}
