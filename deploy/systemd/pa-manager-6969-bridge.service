[Unit]
Description=PA Manager 6969 Terminal Bridge (node/ssh2, port 7002)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sheng/PA-manager-6969/app/terminal_bridge
Environment=TERM_BRIDGE_PORT=7002
Environment=TERM_BRIDGE_HOST=0.0.0.0
Environment=PA_DATA_DIR=/root/sheng/PA-manager-6969/data/pa6969
Environment=CYCLE_BRIDGE_TOKEN_FILE=/root/sheng/PA-manager-6969/data/pa6969/runtime/bridge-token
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
