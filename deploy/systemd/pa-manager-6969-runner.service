[Unit]
Description=PA Manager 6969 (codex/next-rack-cycle) independent runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sheng/PA-manager-6969
Environment=CYCLE_MODE=live
Environment=CYCLE_INSTANCE=data/pa6969
Environment=CYCLE_ARTIFACTS_DIR=CycleTest
Environment=CYCLE_PROVIDER=integration.local_provider
Environment=PYTHONUTF8=1
ExecStart=/root/sheng/PA-manager-6969/.venv/bin/python run.py runner
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
